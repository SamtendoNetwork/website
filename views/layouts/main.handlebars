<!DOCTYPE html>
<html>
	<head>
		<!-- general -->
		<title>Samtendo Network</title>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="manifest" href="/assets/site.webmanifest">
		<meta name="msapplication-config" content="/assets/browserconfig.xml">

		<!-- windows/ios/chrome -->
		<meta http-equiv="X-UA-Compatible" content="ie=edge">
		<meta name="apple-mobile-web-app-title" content="Samtendo Network">
		<meta name="application-name" content="Samtendo Network">
		<meta name="msapplication-TileColor" content="#4ABFFF">
		<meta name="theme-color" content="#4ABFFF">

		<!-- open graph/embeds -->
		<meta property="og:title" content="Samtendo Network">
		<meta property="og:description" content="A mostly open-source replacement for Nintendo Network. We aim to bring people back to the living room on the Wii U and 3DS.">
		<meta property="og:type" content="website">
		<meta property="og:url" content="https://samtendo.net/">
		<meta property="og:image" content="https://cdn.samtendo.net/images/NewSamtendoBanner.png">
		<meta property="og:image:alt" content="Samtendo Network">
		<meta property="og:site_name" content="Samtendo Network">

		<!-- twitter embeds -->
		<meta name="twitter:url" content="https://samtendo.net/">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:site" content="@SamtendoNetwork">
		<meta name="twitter:title" content="Samtendo Network">
		<meta name="twitter:description" content="A mostly open-source replacement for Nintendo Network. We aim to bring people back to the living room on the Wii U and 3DS.">
		<meta name="twitter:image" content="https://cdn.samtendo.net/images/NewSamtendoBanner.png">

		<!-- google seo -->
		<meta name="description" content="A mostly open-source replacement for Nintendo Network. We aim to bring people back to the living room on the Wii U and 3DS.">
		<meta name="robots" content="index, follow">

		<!-- RSS feed -->
		<link rel="alternate" type="application/rss+xml" title="Samtendo Network Blog" href="/blog/feed.xml">

		<!-- favicon -->
		<link rel="apple-touch-icon" sizes="180x180" href="https://cdn.samtendo.net/images/NewSamtendoCircle.png">
		<link rel="icon" type="image/png" sizes="32x32" href="https://cdn.samtendo.net/images/NewSamtendoCircle.png">
		<link rel="icon" type="image/png" sizes="16x16" href="https://cdn.samtendo.net/images/NewSamtendoCircle.png">
		<link rel="mask-icon" href="https://cdn.samtendo.net/images/NewSamtendoCircle.png" color="#4ABFFF">
		<link rel="shortcut icon" href="https://cdn.samtendo.net/images/NewSamtendoCircle.png">

		<!-- css files -->
		<link rel="stylesheet" href="/assets/css/dropdown.css" />
		<link rel="stylesheet" href="/assets/css/main.css" />
		<link rel="stylesheet" href="/assets/css/components.css" />

		<link rel="preconnect" href="https://fonts.gstatic.com">
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">

		<!-- Twemoji setup -->
		<script src="https://cdn.jsdelivr.net/npm/@twemoji/api@15.0.2/dist/twemoji.min.js" integrity="sha384-D6GSzpW7fMH86ilu73eB95ipkfeXcMPoOGVst/L04yqSSe+RTUY0jXcuEIZk0wrT" crossorigin="anonymous"></script>
		<script>
			window.onload = function() {
				twemoji.parse(document.body, {folder: 'svg', ext: '.svg'});
			}
		</script>

		{{#each _sections.head}}
			{{{this}}}
		{{/each}}
	</head>
	<body>
		<div class="main-body">
			{{{ body }}}
		</div>
		<script src="https://cdn.jsdelivr.net/npm/chart.js@3.5.1/dist/chart.min.js"></script>
		<script src="/assets/js/progress-charts.js"></script>

		{{#each _sections.foot}}
			{{{this}}}
		{{/each}}

	</body>
</html>
